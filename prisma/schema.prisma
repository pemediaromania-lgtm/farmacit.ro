generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Producție (Railway): postgresql. Dev local se face acum tot împotriva unui
  // Postgres (vezi README.md, secțiunea Deploy) — migrațiile din acest folder
  // sunt scrise pentru Postgres, nu mai sunt compatibile cu SQLite.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         String        @default("admin") // "admin" | "editor"
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  feeds        Feed[]
  activityLogs ActivityLog[]
}

model Feed {
  id             String    @id @default(cuid())
  name           String
  url            String
  lastImportedAt DateTime?
  lastStatus     String? // "success" | "error"
  lastError      String?
  createdById    String?
  createdBy      User?     @relation(fields: [createdById], references: [id])
  products       Product[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Product {
  id           String    @id @default(cuid())
  feedId       String?
  feed         Feed?     @relation(fields: [feedId], references: [id])
  externalId   String?
  name         String
  slug         String    @unique
  description  String?
  price        Float?
  oldPrice     Float?
  currency     String    @default("RON")
  category     String? // subcategorie (specifică, ex: "Miere de Manuka")
  categoryGroup String? // grupul de nivel superior sub care apare subcategoria (ex: "Suplimente și sănătate naturistă")
  brand        String?
  merchant     String? // magazinul partener (ex: "springfarma.com"), din feed-ul de afiliere
  imageUrl     String?
  gtin         String? // cod de bare (EAN/UPC), pentru date structurate SEO (schema.org Product)
  affiliateUrl String?
  type         String    @default("affiliate") // "affiliate" | "own" (rezervat pt. produse proprii pe viitor)
  availability String?
  isActive     Boolean   @default(true)
  clickCount   Int       @default(0)
  articles     Article[]
  reviews      Review[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([feedId, externalId])
  @@index([category])
  @@index([categoryGroup])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName String
  rating     Int // 1-5
  content    String
  createdAt  DateTime @default(now())

  @@index([productId])
}

model Article {
  id            String    @id @default(cuid())
  productId     String?
  product       Product?  @relation(fields: [productId], references: [id])
  title         String
  slug          String    @unique
  content       String
  excerpt       String?
  faq           String? // JSON: [{ "question": "...", "answer": "..." }] — pentru afișare + schema.org FAQPage
  coverImageUrl String?
  status        String    @default("draft") // "draft" | "published"
  generatedBy   String    @default("ai") // "ai" | "manual"
  publishedAt   DateTime?
  comments      ArticleComment[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

model ArticleComment {
  id         String   @id @default(cuid())
  articleId  String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  authorName String
  content    String
  createdAt  DateTime @default(now())

  @@index([articleId])
}

model CategoryContent {
  id            String   @id @default(cuid())
  categoryGroup String // grupul de nivel superior (ex: "Suplimente și sănătate naturistă")
  category      String   @default("") // "" = pagina grupului; altfel numele subcategoriei (ex: "Miere de Manuka")
  metaTitle     String? // titlu SEO optimizat pe cuvinte-cheie, fără numele site-ului (adăugat automat de template-ul din layout.tsx) — null = se cade pe numele brut al categoriei
  description   String // text SEO, afișat sub grila de produse
  faq           String // JSON: [{ "question": "...", "answer": "..." }]
  generatedBy   String   @default("ai") // "ai" | "manual"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([categoryGroup, category])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // ex: feed.created, feed.imported, product.created, product.updated, article.generated, article.published
  entityType String?
  entityId   String?
  meta       String? // JSON serializat (detalii libere despre acțiune)
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}
